#!/usr/bin/env zsh
# Fake pi binary for smoke tests.

system_prompt=""
user_message=""

[[ -n "${PI_FIXTURE_DELAY:-}" ]] && sleep "$PI_FIXTURE_DELAY"
if [[ "${PI_FIXTURE_FAIL:-0}" == 1 ]]; then
  print -u2 -r -- "simulated pi failure"
  exit 9
fi

while (( $# > 0 )); do
  case "$1" in
    --system-prompt)
      system_prompt="$2"
      shift 2
      ;;
    --model)
      shift 2
      ;;
    --no-extensions|--no-tools|--no-session|-p)
      shift
      ;;
    *)
      user_message="$1"
      shift
      ;;
  esac
done

if [[ "$system_prompt" == *"Provide a terse"* ]]; then
  print -r -- "Lists files with details."
elif [[ "$system_prompt" == *"Provide only zsh commands"* && "$user_message" == "list files" ]]; then
  print -r -- '```zsh'
  print -r -- 'ls -la'
  print -r -- '```'
else
  print -u2 -r -- "unexpected fake pi invocation"
  print -u2 -r -- "system: $system_prompt"
  print -u2 -r -- "user: $user_message"
  exit 2
fi
